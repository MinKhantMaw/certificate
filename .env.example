# Copy this file to .env and fill in your own values. .env is gitignored.

# Supabase project URL and publishable (client-safe) key.
# Dashboard -> Settings -> API. Anything VITE_-prefixed is compiled into the
# public bundle, so the secret / service_role key must NEVER go here.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Endpoint that encrypts a certificate payload into a QR link.
VITE_ENCRYPT_API_URL="https://gi3oqjepp0.execute-api.eu-north-1.amazonaws.com/encrypt"

# Optional. Origin used to build /verify/<token> links when the app is not
# served from the host it is accessed on.
# VITE_PUBLIC_APP_URL="https://certificate-one-mu.vercel.app"
